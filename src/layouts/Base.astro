---
import '../styles/global.css';
import { siteData } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPage?: 'home' | 'our-work' | 'team' | 'contact';
}

const {
  title = 'SAGA16 | Web Design & Development Studio',
  description = siteData.company.description,
  currentPage = 'home',
} = Astro.props;

const { company, nav } = siteData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Progressive enhancement: immediately add 'js' class before rendering styles -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-[#FAF9F8] text-[#1C1B1B] selection:bg-[#E5F0E1] selection:text-[#326262]">
    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-4 py-2 bg-[#326262] text-white rounded-full font-medium shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Sticky Navbar (Clean design matching reference) -->
    <header
      data-site-header
      class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-[#326262]/10"
    >
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
        <!-- Logo: SAGA16 in heavy, italic, uppercase, wide-tracked letters -->
        <a
          href="/"
          class="font-black italic uppercase tracking-tight text-2xl lg:text-3xl text-[#111111] hover:text-[#326262] transition-colors select-none"
          aria-label="SAGA16 Home"
        >
          SAGA16
        </a>

        <!-- Desktop Navigation: Clean text links with active bottom underline (matching reference) -->
        <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
          {nav.map((item) => {
            const isActive =
              (item.href === '/' && currentPage === 'home') ||
              (item.href === '/our-work' && currentPage === 'our-work') ||
              (item.href === '/team' && currentPage === 'team') ||
              (item.href === '/contact' && currentPage === 'contact');

            return (
              <a
                href={item.href}
                class:list={[
                  'text-sm font-semibold transition-all duration-150 py-1',
                  isActive
                    ? 'text-[#111111] border-b-2 border-[#111111]'
                    : 'text-[#586261] hover:text-[#111111]',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
              </a>
            );
          })}
        </nav>

        <!-- CTA & Mobile Toggle (matching reference pill button) -->
        <div class="flex items-center gap-3">
          <a
            href={company.tel}
            class="hidden sm:inline-flex items-center justify-center px-7 py-2.5 rounded-full border border-[#111111] text-[#111111] hover:bg-[#111111] hover:text-white text-sm font-semibold transition-all shadow-sm hover:-translate-y-0.5 active:translate-y-0"
          >
            Call Now
          </a>

          <!-- Mobile Hamburger Toggle -->
          <button
            type="button"
            data-mobile-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
            class="md:hidden p-2.5 rounded-full bg-[#E4EFE6] text-[#111111] hover:bg-[#111111] hover:text-white transition-colors"
          >
            <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div
        id="mobile-menu"
        data-mobile-menu
        class="hidden md:hidden fixed inset-x-0 top-20 bg-white border-b border-[#326262]/10 shadow-xl px-6 py-6"
      >
        <nav class="flex flex-col gap-2">
          {nav.map((item) => {
            const isActive =
              (item.href === '/' && currentPage === 'home') ||
              (item.href === '/our-work' && currentPage === 'our-work') ||
              (item.href === '/team' && currentPage === 'team') ||
              (item.href === '/contact' && currentPage === 'contact');

            return (
              <a
                href={item.href}
                class:list={[
                  'px-4 py-3 rounded-2xl text-base font-semibold transition-colors',
                  isActive
                    ? 'bg-[#111111] text-white'
                    : 'text-[#586261] hover:text-[#111111] hover:bg-[#E4EFE6]',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
              </a>
            );
          })}
          <div class="pt-4 border-t border-[#326262]/10">
            <a
              href={company.tel}
              class="w-full flex items-center justify-center py-3 rounded-full bg-[#111111] text-white font-semibold shadow-md"
            >
              Call Now
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="w-full pt-20">
      <slot />
    </main>

    <!-- Footer: Exact 5-column layout, soft mint background, social pill, contact group, divider, copyright, and giant white watermark -->
    <footer class="relative w-full overflow-hidden bg-[#E4EFE6] text-[#111111] pt-20 pb-8 border-t border-[#2D5854]/15">
      <div class="relative max-w-[1280px] mx-auto px-6 lg:px-12 z-10">
        <!-- Main Footer 5-Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8 pb-12 items-start">
          <!-- Col 1: Brand Logo, Description & Social Pill Container (lg:col-span-4) -->
          <div class="lg:col-span-4 flex flex-col items-start gap-4">
            <a
              href="/"
              class="font-black italic uppercase tracking-tight text-3xl text-[#111111] select-none hover:text-[#2D5854] transition-colors"
              aria-label="SAGA16 Home"
            >
              SAGA16
            </a>
            <p class="text-sm text-[#2D5854] font-medium leading-relaxed max-w-[320px]">
              We're constantly seeking ambitious clients and partners who value precision engineering and refined UI/UX design for web platforms.
            </p>

            <!-- Pill Social Container (matching reference screenshot) -->
            <div class="inline-flex items-center gap-5 px-5 py-2.5 rounded-full border border-[#2D5854]/30 bg-white/40 backdrop-blur-sm mt-2 shadow-xs">
              <!-- LinkedIn -->
              <a
                href={company.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#2D5854] hover:text-[#111111] transition-colors"
                aria-label="LinkedIn"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              </a>

              <!-- GitHub -->
              <a
                href={company.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#2D5854] hover:text-[#111111] transition-colors"
                aria-label="GitHub"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              </a>

              <!-- WhatsApp -->
              <a
                href={company.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#2D5854] hover:text-[#111111] transition-colors"
                aria-label="WhatsApp"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.55c.13.16 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Col 2: Company (lg:col-span-2) -->
          <div class="lg:col-span-2 flex flex-col gap-3">
            <span class="text-sm font-bold text-[#111111] mb-1">
              Company
            </span>
            <a href="/contact" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Contact</a>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Our Work</a>
            <a href="/team" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">About us</a>
            <a href="/team" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Team</a>
          </div>

          <!-- Col 3: Services / Categories (lg:col-span-2) -->
          <div class="lg:col-span-2 flex flex-col gap-3">
            <span class="text-sm font-bold text-[#111111] mb-1">
              Services
            </span>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Institutional</a>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Civic Platforms</a>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Celebrations</a>
          </div>

          <!-- Col 4: Projects (lg:col-span-2) -->
          <div class="lg:col-span-2 flex flex-col gap-3">
            <span class="text-sm font-bold text-[#111111] mb-1">
              Projects
            </span>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">S.N. Public School</a>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">Royal Wedding</a>
            <a href="/our-work" class="text-sm font-medium text-[#2D5854] hover:text-[#111111] transition-colors">CivicVoice</a>
          </div>

          <!-- Col 5: Request a call & Contact Info (lg:col-span-2, matching reference) -->
          <div class="lg:col-span-2 flex flex-col items-start gap-3">
            <!-- Pill Button -->
            <a
              href={company.tel}
              class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#2D5854] hover:bg-[#1D3E3A] text-white text-sm font-semibold transition-all shadow-sm hover:-translate-y-0.5 active:translate-y-0"
            >
              Request a call
            </a>

            <!-- Phone Number (underlined as in screenshot) -->
            <a
              href={company.tel}
              class="text-sm font-bold text-[#111111] hover:text-[#2D5854] transition-colors underline underline-offset-4 decoration-[#111111]/60"
            >
              {company.phone}
            </a>

            <!-- Email (underlined as in screenshot) -->
            <a
              href={company.mailto}
              class="text-sm font-medium text-[#111111] hover:text-[#2D5854] transition-colors underline underline-offset-4 decoration-[#111111]/60"
            >
              {company.email}
            </a>

            <!-- Location (underlined as in screenshot) -->
            <span class="text-xs font-semibold text-[#111111] underline underline-offset-4 decoration-[#111111]/60">
              {company.location}
            </span>
          </div>
        </div>

        <!-- Hairline Divider (matching reference) -->
        <div class="border-t border-[#2D5854]/20 pt-8 pb-4 text-center">
          <p class="text-xs sm:text-sm text-[#111111] font-bold">
            {company.copyright}. All rights reserved.
          </p>
        </div>
      </div>

      <!-- Effect 8: Giant Oversized Brand Watermark Typography at bottom in pure crisp white (exact match to LEVEIN watermark) -->
      <div class="relative w-full overflow-hidden pointer-events-none select-none flex justify-center -mb-8 lg:-mb-16 pt-6">
        <span
          data-reveal="letters"
          class="font-black italic uppercase tracking-tighter text-[26vw] leading-none text-white select-none whitespace-nowrap block drop-shadow-xs"
        >
          SAGA16
        </span>
      </div>
    </footer>

    <!-- Client Scripts -->
    <script src="../scripts/main.ts"></script>
  </body>
</html>
