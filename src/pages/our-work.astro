---
import Base from '../layouts/Base.astro';
import BentoGrid from '../components/BentoGrid.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TechRibbon from '../components/TechRibbon.astro';
import ContactBand from '../components/ContactBand.astro';
import { siteData } from '../data/site';

const { categories, contactBands } = siteData;
---

<Base currentPage="our-work" title="Our Work | SAGA16 Portfolio">
  <!-- Header Section with Dark Cinematic Teal and LIVE PROJECTS Marquee -->
  <section class="relative w-full bg-gradient-to-b from-[#1D4E4F] via-[#143637] to-[#091414] text-white py-20 lg:py-28 overflow-hidden">
    <!-- Soft Teal Glow Overlay -->
    <div
      class="pointer-events-none absolute inset-0 opacity-30"
      style="background: radial-gradient(circle at 50% 25%, rgba(158, 244, 204, 0.28) 0%, transparent 70%);"
    ></div>

    <div class="relative max-w-[1280px] mx-auto px-6 lg:px-12 flex flex-col items-center text-center z-10">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md mb-6">
        <span class="w-2 h-2 rounded-full bg-[#6BBF9A] animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-[#6BBF9A] font-bold">OUR WORK</span>
      </div>

      <!-- Main Heading with Text Reveal (Effect 1) -->
      <h1
        data-reveal="text"
        class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-white max-w-4xl mb-6 leading-[1.1]"
      >
        Websites we have built and launched
      </h1>

      <p
        data-reveal="text"
        class="text-base sm:text-lg text-[#A9B5B4] max-w-2xl mb-12 font-normal leading-relaxed"
      >
        From a real school website to civic platforms and wedding invitations, every project below is live. Open any of them and try it.
      </p>

      <!-- Infinite Marquee Strip with Corner Brackets (Effect 3) -->
      <div class="w-full relative py-4 px-6 rounded-xl bg-white/5 backdrop-blur-sm overflow-hidden flex items-center border border-white/10 marquee-container marquee-fade-mask shadow-lg">
        <!-- Corner brackets -->
        <span class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>

        <div class="shrink-0 flex items-center gap-2 pr-6 border-r border-white/20 mr-6">
          <svg class="w-4 h-4 text-[#6BBF9A] fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="text-xs font-bold uppercase tracking-widest text-[#6BBF9A]">LIVE PROJECTS</span>
        </div>

        <div class="marquee-track-left items-center gap-8 py-1 select-none">
          {categories.marqueeProjects.map((project) => (
            <div class="inline-flex items-center gap-8 shrink-0">
              <span class="text-sm font-semibold tracking-wider text-white whitespace-nowrap">
                {project}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#6BBF9A] shrink-0" aria-hidden="true"></span>
            </div>
          ))}

          <!-- Duplicated set for seamless loop -->
          {categories.marqueeProjects.map((project) => (
            <div class="inline-flex items-center gap-8 shrink-0" aria-hidden="true">
              <span class="text-sm font-semibold tracking-wider text-white whitespace-nowrap">
                {project}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#6BBF9A] shrink-0"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Full-Bleed Bento Grid & Filters Section -->
  <section class="max-w-[1280px] mx-auto px-6 lg:px-12 py-16 lg:py-24">
    <BentoGrid />
  </section>

  <!-- Process (Sticky Column Layout) -->
  <ProcessSection />

  <!-- Tech Ribbon (Two-Row Opposite-Direction Carousel) -->
  <TechRibbon />

  <!-- Closing CTA Band with Oversized Brand Type Behind -->
  <ContactBand
    heading={contactBands.ourWork.heading}
    showEmail={true}
  />
</Base>
