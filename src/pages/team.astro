---
import Base from '../layouts/Base.astro';
import TeamCardsSection from '../components/TeamCardsSection.astro';
import TeamWhySection from '../components/TeamWhySection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ContactBand from '../components/ContactBand.astro';
import { siteData } from '../data/site';

const { contactBands } = siteData;
---

<Base currentPage="team" title="Team | SAGA16 Studio">
  <!-- Team Page Header (Dark Teal with soft radial glow) -->
  <section class="relative w-full overflow-hidden bg-[#091414] text-white py-14 sm:py-20 lg:py-28">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background: radial-gradient(circle at 50% 30%, rgba(107, 191, 154, 0.3) 0%, rgba(9, 20, 20, 0) 70%);"
    ></div>

    <div class="relative max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col items-center text-center z-10">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md mb-5 sm:mb-6">
        <span class="w-2 h-2 rounded-full bg-[#6BBF9A]"></span>
        <span class="text-xs uppercase tracking-widest text-[#6BBF9A] font-bold">TEAM</span>
      </div>

      <!-- Heading with text reveal -->
      <h1
        data-reveal="text"
        class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-white max-w-4xl mb-4 sm:mb-6 leading-[1.15]"
      >
        The people behind SAGA16
      </h1>

      <p
        data-reveal="text"
        class="text-sm sm:text-base lg:text-lg text-[#A9B5B4] max-w-2xl font-normal leading-relaxed"
      >
        Two full-stack developers and one UI/UX designer, working together on every website from first call to launch.
      </p>
    </div>
  </section>

  <!-- Three Team Cards (Box Reveal, Tilt) -->
  <TeamCardsSection />

  <!-- "Why work with SAGA16" (Sticky Column Layout, Tilt) -->
  <TeamWhySection />

  <!-- "How we work together" (Same 4 steps, Sticky Column Layout) -->
  <ProcessSection
    eyebrow="COLLABORATION"
    heading="How we work together"
  />

  <!-- CTA Band with Oversized Brand Type Behind -->
  <ContactBand
    heading={contactBands.team.heading}
    showEmail={true}
  />
</Base>
