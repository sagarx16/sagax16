---
import { siteData } from '../data/site';
const { projects } = siteData;

const featuredProject = projects[0]; // S.N. Public School & Tuition Center

// Keynote Ambient Stage Themes per project
const projectThemes = [
  {
    // Project 0: S.N. Public School & Tuition Center (8 cols, 2 rows)
    tag: 'Institutional & Business',
    mockUrl: 'sn-public-school.edu.in',
    imgSrc: '/projects/sn-public-school.png',
    cardBg: 'from-[#1C1513] via-[#120F0E] to-[#0A0808]',
    spotlight: 'radial-gradient(circle at 70% 35%, rgba(245, 158, 11, 0.22) 0%, rgba(220, 38, 38, 0.08) 45%, transparent 70%)',
    borderColor: 'border-amber-500/25 hover:border-amber-400/70',
    shadowHover: 'hover:shadow-[0_25px_65px_-12px_rgba(245,158,11,0.28)]',
    pillBg: 'bg-amber-400/15 text-amber-300 border-amber-400/30',
    titleHover: 'group-hover:text-amber-200',
    arrowStyle: 'bg-amber-400 text-black shadow-[0_4px_16px_rgba(251,191,36,0.45)] group-hover:bg-amber-300 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(251,191,36,0.8)]',
    summary: 'Full-fledged CBSE academy platform with interactive curriculum wings & real admissions.',
    accentDot: 'bg-amber-400'
  },
  {
    // Project 1: Royal Wedding Invitation (4 cols, 2 rows)
    tag: 'Celebration & Luxury',
    mockUrl: 'invifest.royal-invitation',
    imgSrc: '/projects/royal-wedding-mobile.png',
    cardBg: 'from-[#2B0E14] via-[#19080C] to-[#0B0406]',
    spotlight: 'radial-gradient(circle at 50% 45%, rgba(212, 175, 55, 0.28) 0%, rgba(180, 83, 9, 0.12) 42%, transparent 70%)',
    borderColor: 'border-[#D4AF37]/40 hover:border-[#D4AF37]/90',
    shadowHover: 'hover:shadow-[0_25px_65px_-12px_rgba(212,175,55,0.3)]',
    pillBg: 'bg-[#D4AF37]/20 text-[#F5E6BE] border-[#D4AF37]/40',
    titleHover: 'group-hover:text-[#F5E6BE]',
    arrowStyle: 'bg-[#D4AF37] text-black shadow-[0_4px_16px_rgba(212,175,55,0.45)] group-hover:bg-[#e6c44d] group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(212,175,55,0.8)]',
    summary: 'Velvet maroon envelope with gold wax seal, animated music & guest RSVP ceremony.',
    accentDot: 'bg-[#D4AF37]'
  },
  {
    // Project 2: CivicVoice (6 cols, 1 row)
    tag: 'Civic & Government',
    mockUrl: 'civicvoice.platform',
    imgSrc: '/projects/civic-voice.png',
    cardBg: 'from-[#0C1B33] via-[#071124] to-[#030814]',
    spotlight: 'radial-gradient(circle at 65% 40%, rgba(56, 189, 248, 0.24) 0%, rgba(37, 99, 235, 0.08) 45%, transparent 70%)',
    borderColor: 'border-sky-500/30 hover:border-sky-400/80',
    shadowHover: 'hover:shadow-[0_22px_55px_-12px_rgba(56,189,248,0.28)]',
    pillBg: 'bg-sky-500/15 text-sky-300 border-sky-500/30',
    titleHover: 'group-hover:text-sky-200',
    arrowStyle: 'bg-sky-400 text-black shadow-[0_4px_16px_rgba(56,189,248,0.45)] group-hover:bg-sky-300 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(56,189,248,0.8)]',
    summary: 'Democratic civic participation hub for reporting issues, voting on budgets & city forums.',
    accentDot: 'bg-sky-400'
  },
  {
    // Project 3: PocketBank (6 cols, 1 row)
    tag: 'Fintech & Banking',
    mockUrl: 'pocketbank.app',
    imgSrc: '/projects/pocketbank.png',
    cardBg: 'from-[#082218] via-[#051710] to-[#020A07]',
    spotlight: 'radial-gradient(circle at 65% 40%, rgba(52, 211, 153, 0.24) 0%, rgba(16, 185, 129, 0.08) 45%, transparent 70%)',
    borderColor: 'border-emerald-500/30 hover:border-emerald-400/80',
    shadowHover: 'hover:shadow-[0_22px_55px_-12px_rgba(52,211,153,0.28)]',
    pillBg: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
    titleHover: 'group-hover:text-emerald-200',
    arrowStyle: 'bg-emerald-400 text-black shadow-[0_4px_16px_rgba(52,211,153,0.45)] group-hover:bg-emerald-300 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(52,211,153,0.8)]',
    summary: 'Next-gen student banking ecosystem with high-yield savings & instant parent allowances.',
    accentDot: 'bg-emerald-400'
  },
  {
    // Project 4: Sachet (6 cols, 1 row)
    tag: 'Disaster Intelligence',
    mockUrl: 'sachet.disaster-grid',
    imgSrc: '/projects/sachet.png',
    cardBg: 'from-[#101E38] via-[#0A1325] to-[#040812]',
    spotlight: 'radial-gradient(circle at 65% 40%, rgba(99, 102, 241, 0.24) 0%, rgba(59, 130, 246, 0.08) 45%, transparent 70%)',
    borderColor: 'border-indigo-500/30 hover:border-indigo-400/80',
    shadowHover: 'hover:shadow-[0_22px_55px_-12px_rgba(99,102,241,0.28)]',
    pillBg: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/30',
    titleHover: 'group-hover:text-indigo-200',
    arrowStyle: 'bg-indigo-400 text-black shadow-[0_4px_16px_rgba(129,140,248,0.45)] group-hover:bg-indigo-300 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(129,140,248,0.8)]',
    summary: 'Unified flood forecast grid & cross-border crisis coordination across India & Nepal.',
    accentDot: 'bg-indigo-400'
  },
  {
    // Project 5: Studio Ghibli Tribute (6 cols, 1 row)
    tag: 'Cinematic Tribute',
    mockUrl: 'ghibli.cinema/dark',
    imgSrc: '/projects/ghibli-tribute.png',
    cardBg: 'from-[#220F3A] via-[#150926] to-[#090412]',
    spotlight: 'radial-gradient(circle at 65% 40%, rgba(192, 132, 252, 0.26) 0%, rgba(147, 51, 234, 0.08) 45%, transparent 70%)',
    borderColor: 'border-purple-500/30 hover:border-purple-400/80',
    shadowHover: 'hover:shadow-[0_22px_55px_-12px_rgba(192,132,252,0.3)]',
    pillBg: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
    titleHover: 'group-hover:text-purple-200',
    arrowStyle: 'bg-purple-400 text-black shadow-[0_4px_16px_rgba(192,132,252,0.45)] group-hover:bg-purple-300 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(192,132,252,0.8)]',
    summary: 'Dark-mode interactive cinematic archive honoring Hayao Miyazaki’s 23 timeless films.',
    accentDot: 'bg-purple-400'
  },
  {
    // Project 6: Sage Wellness (Dr. Maya Reynolds, PsyD)
    tag: 'Therapy & Healthcare',
    mockUrl: 'sage-wellness.app',
    imgSrc: '/projects/sage-wellness.png',
    cardBg: 'from-[#0E241E] via-[#091A15] to-[#040D0B]',
    spotlight: 'radial-gradient(circle at 65% 40%, rgba(107, 191, 154, 0.28) 0%, rgba(35, 75, 60, 0.12) 45%, transparent 70%)',
    borderColor: 'border-[#6BBF9A]/30 hover:border-[#6BBF9A]/80',
    shadowHover: 'hover:shadow-[0_22px_55px_-12px_rgba(107,191,154,0.3)]',
    pillBg: 'bg-[#6BBF9A]/15 text-[#6BBF9A] border-[#6BBF9A]/30',
    titleHover: 'group-hover:text-[#A7E3C8]',
    arrowStyle: 'bg-[#6BBF9A] text-black shadow-[0_4px_16px_rgba(107,191,154,0.45)] group-hover:bg-[#85d4b1] group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(107,191,154,0.8)]',
    summary: 'Calming, trauma-informed therapy practice website with telehealth booking, specialties and consultation flow.',
    accentDot: 'bg-[#6BBF9A]'
  }
];
---

<div class="w-full">
  <!-- Filter Chips (Horizontally scrollable on mobile without wrapping, smooth snap) -->
  <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 -mx-5 px-5 sm:mx-0 sm:px-0 sm:flex-wrap w-full sm:w-auto" role="group" aria-label="Filter projects by category">
      <button
        type="button"
        data-filter-btn="all"
        aria-pressed="true"
        class="active-filter-pill shrink-0 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#326262] text-white shadow-sm"
      >
        All
      </button>
      <button
        type="button"
        data-filter-btn="institutional-business"
        aria-pressed="false"
        class="shrink-0 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Institutional &amp; Business
      </button>
      <button
        type="button"
        data-filter-btn="civic-government"
        aria-pressed="false"
        class="shrink-0 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Civic &amp; Government
      </button>
      <button
        type="button"
        data-filter-btn="celebration"
        aria-pressed="false"
        class="shrink-0 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Celebration
      </button>
      <button
        type="button"
        data-filter-btn="fan-project"
        aria-pressed="false"
        class="shrink-0 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Fan project
      </button>
    </div>

    <div class="hidden sm:flex items-center gap-2 text-[#586261] text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-[#6BBF9A] animate-pulse"></span>
      <span>Live Verified Links</span>
    </div>
  </div>

  <!-- Primary 4 Cards Bento Grid (Rows 1 & 2) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6">
    {projects.slice(0, 4).map((p, index) => {
      // Bento layout spans & heights optimized for mobile & desktop
      let cardClasses = 'lg:col-span-6 min-h-[380px] xs:min-h-[420px] sm:min-h-[500px] lg:min-h-[550px]';
      if (index === 0) cardClasses = 'lg:col-span-8 min-h-[440px] xs:min-h-[480px] sm:min-h-[580px] lg:min-h-[660px]';
      else if (index === 1) cardClasses = 'lg:col-span-4 min-h-[440px] xs:min-h-[480px] sm:min-h-[580px] lg:min-h-[660px]';

      const theme = projectThemes[index] || projectThemes[0];

      return (
        <a
          href={p.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${p.title} live site`}
          data-project-category={p.category}
          data-project-index={index}
          class:list={[
            'group relative rounded-[24px] sm:rounded-[28px] overflow-hidden border bg-gradient-to-br transition-all duration-500 flex flex-col justify-between p-5 xs:p-6 sm:p-8',
            theme.cardBg,
            theme.borderColor,
            theme.shadowHover,
            cardClasses,
          ]}
        >
          {/* Ambient Spotlight Glow Background */}
          <div
            class="pointer-events-none absolute inset-0 opacity-80 group-hover:opacity-100 transition-opacity duration-700"
            style={`background: ${theme.spotlight};`}
          ></div>

          {/* Subtle Keynote Grid Pattern Overlay */}
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.12] group-hover:opacity-[0.18] transition-opacity duration-700"
            style="background-image: radial-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px); background-size: 24px 24px;"
          ></div>

          {/* Top Header: Tag Pill, Tech Chip, Arrow Button, Title, Subtitle */}
          <div class="relative z-10 flex flex-col gap-2 mb-4 shrink-0">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class:list={['px-3 py-1 rounded-full text-xs font-mono font-medium tracking-tight border shadow-sm', theme.pillBg]}>
                  {p.label}
                </span>
                <span class="hidden sm:inline-block px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-white/50 text-[11px] font-mono">
                  {p.tech[0]}
                </span>
              </div>
              <!-- Light Glassmorphism Arrow Button -->
              <span class="w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all duration-300 shrink-0 cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-white/40 text-white shadow-[0_4px_16px_rgba(0,0,0,0.25),inset_0_1px_1px_rgba(255,255,255,0.4)] group-hover:bg-white/25 group-hover:border-white/50 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(255,255,255,0.35)]">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-none stroke-current stroke-[2.5] transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 text-white" viewBox="0 0 24 24">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </div>

            <div>
              <h3 class:list={['text-2xl sm:text-3xl font-semibold text-white transition-colors leading-snug', theme.titleHover]}>
                {p.title}
              </h3>
              <p class="text-xs sm:text-sm text-white/60 mt-1 line-clamp-1 font-normal leading-relaxed">
                {theme.summary}
              </p>
            </div>
          </div>

          {/* Centered Floating Mockup Stage */}
          <div class="relative w-full flex-1 flex items-center justify-center overflow-hidden">
            {index === 0 && (
              /* Card 0: S.N. Public School - Large Floating Desktop Showcase */
              <div class="w-full h-full max-h-[540px] rounded-2xl border border-white/20 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9)] overflow-hidden transition-all duration-500 ease-out group-hover:-translate-y-2 group-hover:scale-[1.01]">
                <img
                  src={theme.imgSrc}
                  alt={p.title}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
            )}

            {index === 1 && (
              /* Card 1: Royal Wedding - Floating Luxury Smartphone Mockup with Ambient Halo */
              <div class="w-[235px] sm:w-[255px] rounded-[3rem] p-3 bg-gradient-to-b from-[#2B151C] to-[#12070A] border-2 border-[#D4AF37]/50 shadow-[0_30px_70px_-15px_rgba(0,0,0,0.95)] flex flex-col transition-all duration-500 ease-out group-hover:-translate-y-2 group-hover:scale-[1.03] my-auto">
                <!-- Dynamic Island -->
                <div class="w-20 h-4 bg-black rounded-full mx-auto mb-2 flex items-center justify-between px-2.5 ring-1 ring-white/10 shrink-0">
                  <span class="w-2 h-2 rounded-full bg-[#1b2a3a]"></span>
                  <span class="w-1.5 h-1.5 rounded-full bg-[#2a3b4c]"></span>
                </div>
                <!-- Phone Screen with Royal Wedding Mobile Screenshot -->
                <div class="w-full rounded-[2.3rem] overflow-hidden aspect-[9/17] relative bg-black shadow-inner">
                  <img
                    src={theme.imgSrc}
                    alt={p.title}
                    class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.05] to-white/[0.15] pointer-events-none"></div>
                </div>
              </div>
            )}

            {index > 1 && (
              /* Cards 2-3: Floating Sleek Showcase Windows */
              <div class="w-full h-full max-h-[360px] sm:max-h-[380px] lg:max-h-[410px] rounded-xl sm:rounded-2xl border border-white/20 shadow-[0_20px_50px_-10px_rgba(0,0,0,0.85)] overflow-hidden relative transition-all duration-500 ease-out group-hover:-translate-y-2 group-hover:scale-[1.02]">
                <img
                  src={theme.imgSrc}
                  alt={p.title}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            )}
          </div>
        </a>
      );
    })}
  </div>

  <!-- Collapsible Extra Projects Wrapper (CSS Grid 1fr to 0fr transition) -->
  <div
    id="bento-extra-wrapper"
    data-bento-extra-wrapper
    class="bento-extra-wrapper"
    hidden
    inert
  >
    <div class="bento-extra-inner">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 pt-5 sm:pt-6">
        {projects.slice(4).map((p, offset, arr) => {
          const index = offset + 4;
          const isOddCount = arr.length % 2 !== 0;
          const isLast = offset === arr.length - 1;
          const spanClass = isOddCount && isLast ? 'lg:col-span-12' : 'lg:col-span-6';
          const cardClasses = isOddCount && isLast
            ? 'lg:col-span-12 min-h-[440px] xs:min-h-[480px] sm:min-h-[560px] lg:min-h-[660px]'
            : `${spanClass} min-h-[380px] xs:min-h-[420px] sm:min-h-[500px] lg:min-h-[550px]`;
          const theme = projectThemes[index] || projectThemes[0];

          return (
            <a
              href={p.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${p.title} live site`}
              data-project-category={p.category}
              data-project-index={index}
              data-bento-extra-card
              class:list={[
                'group relative rounded-[24px] sm:rounded-[28px] overflow-hidden border bg-gradient-to-br transition-all duration-500 flex flex-col justify-between p-5 xs:p-6 sm:p-8',
                theme.cardBg,
                theme.borderColor,
                theme.shadowHover,
                cardClasses,
              ]}
            >
              {/* Ambient Spotlight Glow Background */}
              <div
                class="pointer-events-none absolute inset-0 opacity-80 group-hover:opacity-100 transition-opacity duration-700"
                style={`background: ${theme.spotlight};`}
              ></div>

              {/* Subtle Keynote Grid Pattern Overlay */}
              <div
                class="pointer-events-none absolute inset-0 opacity-[0.12] group-hover:opacity-[0.18] transition-opacity duration-700"
                style="background-image: radial-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px); background-size: 24px 24px;"
              ></div>

              {/* Top Header: Tag Pill, Tech Chip, Arrow Button, Title, Subtitle */}
              <div class="relative z-10 flex flex-col gap-2 mb-4 shrink-0">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <span class:list={['px-3 py-1 rounded-full text-xs font-mono font-medium tracking-tight border shadow-sm', theme.pillBg]}>
                      {p.label}
                    </span>
                    <span class="hidden sm:inline-block px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-white/50 text-[11px] font-mono">
                      {p.tech[0]}
                    </span>
                  </div>
                  <!-- Light Glassmorphism Arrow Button -->
                  <span class="w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all duration-300 shrink-0 cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-white/40 text-white shadow-[0_4px_16px_rgba(0,0,0,0.25),inset_0_1px_1px_rgba(255,255,255,0.4)] group-hover:bg-white/25 group-hover:border-white/50 group-hover:scale-110 group-hover:shadow-[0_0_24px_rgba(255,255,255,0.35)]">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-none stroke-current stroke-[2.5] transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 text-white" viewBox="0 0 24 24">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </span>
                </div>

                <div>
                  <h3 class:list={['text-2xl sm:text-3xl font-semibold text-white transition-colors leading-snug', theme.titleHover]}>
                    {p.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-white/60 mt-1 line-clamp-1 font-normal leading-relaxed">
                    {theme.summary}
                  </p>
                </div>
              </div>

              {/* Centered Floating Mockup Stage */}
              <div class="relative w-full flex-1 flex items-center justify-center overflow-hidden">
                <div class:list={[
                  'w-full h-full rounded-xl sm:rounded-2xl border border-white/20 shadow-[0_20px_50px_-10px_rgba(0,0,0,0.85)] overflow-hidden relative transition-all duration-500 ease-out group-hover:-translate-y-2 group-hover:scale-[1.02]',
                  isOddCount && isLast ? 'max-w-[1040px] mx-auto max-h-[460px] sm:max-h-[520px] lg:max-h-[580px]' : 'max-h-[360px] sm:max-h-[380px] lg:max-h-[410px]'
                ]}>
                  <img
                    src={theme.imgSrc}
                    alt={p.title}
                    width="1200"
                    height="800"
                    class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- View More Button -->
  <div class="mt-8 sm:mt-10 flex justify-center" data-bento-more-container>
    <button
      type="button"
      id="bento-more-btn"
      data-bento-more-btn
      aria-expanded="false"
      aria-controls="bento-extra-wrapper"
      class="group inline-flex items-center gap-2.5 px-8 py-3.5 rounded-full bg-[#326262] hover:bg-[#254c4c] text-white font-semibold text-sm transition-all duration-300 shadow-[0_4px_18px_-2px_rgba(50,98,98,0.35)] hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] cursor-pointer"
    >
      <span data-bento-more-text class="inline-block min-w-[72px] text-center">View More</span>
      <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold transition-transform duration-300" data-bento-more-icon>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2 transition-transform duration-300" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </button>
  </div>

<style>
  .bento-extra-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bento-extra-wrapper.is-open {
    grid-template-rows: 1fr;
    transition: none;
  }
  .bento-extra-wrapper.is-collapsing {
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bento-extra-inner {
    overflow: hidden;
    min-height: 0;
  }
  [data-bento-extra-card] {
    will-change: transform, opacity;
  }
</style>

  <!-- Featured Project Details Area below the bento grid for S.N. Public School -->
  <div class="mt-12 bg-white rounded-[24px] p-8 lg:p-12 border border-[#326262]/10 shadow-[0_4px_24px_-2px_rgba(50,98,98,0.06)]">
    <div class="flex flex-col lg:flex-row items-start justify-between gap-8">
      <div class="lg:w-1/2">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
            {featuredProject.label}
          </span>
          <span class="text-xs text-[#586261] font-medium">Bokaro Steel City</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-medium text-[#1C1B1B] mb-3 leading-snug">
          {featuredProject.title}
        </h3>

        <p class="text-base text-[#586261] leading-relaxed mb-6">
          {featuredProject.description}
        </p>

        <!-- Tech Badges -->
        <div class="flex flex-wrap gap-2 mb-6">
          {featuredProject.tech.map((t) => (
            <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
              {t}
            </span>
          ))}
        </div>

        <a
          href={featuredProject.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#326262] hover:bg-[#3E6161] text-white text-sm font-semibold transition-all shadow-sm"
        >
          <span>Open Live School Website</span>
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Features List -->
      <div class="lg:w-1/2 flex flex-col gap-3">
        <h4 class="text-xs uppercase tracking-widest text-[#326262] font-bold mb-2">
          KEY FEATURES &amp; MODULES
        </h4>
        {featuredProject.features?.map((feat) => (
          <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-[#FAF9F8] border border-[#326262]/5">
            <svg class="w-5 h-5 text-[#6BBF9A] shrink-0 mt-0.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm text-[#1C1B1B] font-medium leading-relaxed">
              {feat}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
