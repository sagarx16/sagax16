---
import { siteData } from '../data/site';
const { projects } = siteData;

const featuredProject = projects[0]; // S.N. Public School & Tuition Center
---

<div class="w-full">
  <!-- Filter Chips (Real client-side filter with smooth transition) -->
  <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
    <div class="flex items-center gap-2 flex-wrap" role="group" aria-label="Filter projects by category">
      <button
        type="button"
        data-filter-btn="all"
        aria-pressed="true"
        class="active-filter-pill px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#326262] text-white shadow-sm"
      >
        All
      </button>
      <button
        type="button"
        data-filter-btn="institutional-business"
        aria-pressed="false"
        class="px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Institutional &amp; Business
      </button>
      <button
        type="button"
        data-filter-btn="civic-government"
        aria-pressed="false"
        class="px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Civic &amp; Government
      </button>
      <button
        type="button"
        data-filter-btn="celebration"
        aria-pressed="false"
        class="px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Celebration
      </button>
      <button
        type="button"
        data-filter-btn="fan-project"
        aria-pressed="false"
        class="px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-[#E5F0E1] text-[#326262] hover:bg-[#d6e7d0]"
      >
        Fan project
      </button>
    </div>

    <div class="flex items-center gap-2 text-[#586261] text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-[#6BBF9A] animate-pulse"></span>
      <span>Live Verified Links</span>
    </div>
  </div>

  <!-- Effect 7: Full-bleed masonry/bento grid with aesthetic device and browser mockups -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 auto-rows-[300px] lg:auto-rows-[320px]">
    {projects.map((p, index) => {
      // Bento layout spans
      let colSpan = 'lg:col-span-4 row-span-1';
      if (index === 0) colSpan = 'lg:col-span-8 row-span-2';
      else if (index === 1) colSpan = 'lg:col-span-4 row-span-2';
      else if (index === 2) colSpan = 'lg:col-span-4 row-span-1';
      else if (index === 3) colSpan = 'lg:col-span-4 row-span-1';
      else if (index === 4) colSpan = 'lg:col-span-6 row-span-1';
      else if (index === 5) colSpan = 'lg:col-span-6 row-span-1';

      // Specific mock URL per project
      const mockUrls = [
        'sn-public-school.edu.in',
        'invifest.royal-invitation',
        'civicvoice.platform',
        'pocketbank.app',
        'sachet.disaster-grid',
        'ghibli.cinema/dark'
      ];
      const mockUrl = mockUrls[index] || 'saga16.live';

      return (
        <a
          href={p.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-project-category={p.category}
          data-reveal="box"
          data-box-color={index % 2 === 0 ? 'teal' : 'green'}
          class:list={[
            'group relative rounded-[28px] overflow-hidden border border-[#326262]/15 bg-[#0C1013] shadow-[0_4px_24px_-2px_rgba(50,98,98,0.08)] hover:border-[#6BBF9A]/60 hover:shadow-[0_16px_40px_-6px_rgba(50,98,98,0.22)] transition-all duration-500 flex flex-col justify-between p-6',
            colSpan,
          ]}
        >
          {/* Card Mockup Visual Container */}
          <div class="box-content absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
            {index === 0 && (
              /* Card 0: S.N. Public School - Large Floating Desktop Browser */
              <div class="w-full h-full bg-gradient-to-br from-[#161B20] via-[#0E1216] to-[#0A0D10] p-4 sm:p-6 flex flex-col justify-start">
                <div class="w-full max-w-[96%] mx-auto rounded-xl sm:rounded-2xl border border-white/15 bg-[#1A1E24] shadow-[0_20px_50px_rgba(0,0,0,0.8)] overflow-hidden transition-transform duration-700 ease-out group-hover:scale-[1.02] group-hover:-translate-y-1">
                  <!-- Browser Window Bar -->
                  <div class="px-4 py-2.5 bg-[#14171B] border-b border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]/90"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]/90"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]/90"></span>
                    </div>
                    <div class="px-3 py-0.5 rounded-full bg-white/10 text-[11px] text-white/70 font-mono tracking-tight flex items-center gap-1.5 border border-white/5">
                      <svg class="w-2.5 h-2.5 text-[#6BBF9A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0110 0v4"></path>
                      </svg>
                      <span>{mockUrl}</span>
                    </div>
                    <span class="text-[10px] text-white/40 font-mono uppercase tracking-wider">{p.tech[0]}</span>
                  </div>
                  <!-- Browser Content -->
                  <div class="w-full aspect-[16/9] sm:aspect-[16/10] overflow-hidden bg-black">
                    <img
                      src="/projects/sn-public-school.png"
                      alt={p.title}
                      class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            )}

            {index === 1 && (
              /* Card 1: Royal Wedding - Floating Luxury Smartphone Mockup */
              <div class="w-full h-full bg-gradient-to-br from-[#24171B] via-[#160E12] to-[#0A0709] p-4 flex flex-col items-center justify-start">
                <div class="w-[210px] sm:w-[230px] rounded-t-[2.8rem] p-2 bg-[#1C1619] border-t-2 border-x-2 border-[#D4AF37]/30 shadow-[0_25px_60px_rgba(0,0,0,0.85)] transition-transform duration-700 ease-out group-hover:-translate-y-2 mt-2">
                  <!-- Dynamic Island -->
                  <div class="w-14 h-3.5 bg-black rounded-full mx-auto mb-2 flex items-center justify-between px-2 ring-1 ring-white/10">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#1b2a3a]"></span>
                    <span class="w-1 h-1 rounded-full bg-[#2a3b4c]"></span>
                  </div>
                  <!-- Phone Screen with Royal Wedding Mobile Screenshot -->
                  <div class="w-full rounded-t-[2.1rem] overflow-hidden aspect-[9/18] relative bg-black shadow-inner">
                    <img
                      src="/projects/royal-wedding-mobile.png"
                      alt={p.title}
                      class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.04] to-white/[0.12] pointer-events-none"></div>
                  </div>
                </div>
              </div>
            )}

            {index > 1 && (
              /* Cards 2-5: Floating Sleek Browser Windows with Theme Accents */
              <div class="w-full h-full bg-gradient-to-br from-[#14181D] via-[#0E1216] to-[#080B0D] p-3 sm:p-4 flex flex-col justify-start">
                <div class="w-full h-full rounded-2xl border border-white/15 bg-[#161A20] shadow-[0_16px_40px_rgba(0,0,0,0.7)] overflow-hidden transition-transform duration-700 ease-out group-hover:scale-[1.02] group-hover:-translate-y-1">
                  <!-- Browser Bar -->
                  <div class="px-3.5 py-2 bg-[#121519] border-b border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]/90"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]/90"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]/90"></span>
                    </div>
                    <div class="px-2.5 py-0.5 rounded-full bg-white/10 text-[10px] text-white/70 font-mono tracking-tight flex items-center gap-1 border border-white/5">
                      <span>{mockUrl}</span>
                    </div>
                    <span class="text-[9px] text-[#6BBF9A] font-mono font-semibold uppercase">{p.tech[0]}</span>
                  </div>
                  <!-- Screen -->
                  <div class="w-full h-full relative overflow-hidden bg-black">
                    <img
                      src={p.image}
                      alt={p.title}
                      class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            )}

            <!-- Protective Gradient Overlay for Bottom Caption Readability -->
            <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-[#090D10] via-[#090D10]/90 to-transparent pointer-events-none"></div>
          </div>

          <!-- Visible Caption: Label Pill, Arrow CTA and Title -->
          <div class="relative z-10 flex flex-col gap-2 mt-auto">
            <div class="flex items-center justify-between gap-2">
              <span class="px-3 py-1 rounded-full bg-[#E5F0E1]/90 backdrop-blur-md text-[#326262] text-xs font-semibold shadow-sm">
                {p.label}
              </span>
              <span class="w-8 h-8 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-white flex items-center justify-center opacity-85 group-hover:opacity-100 group-hover:bg-[#6BBF9A] group-hover:text-[#091414] group-hover:border-[#6BBF9A] transition-all duration-300 shadow-lg">
                <svg class="w-4 h-4 fill-none stroke-current stroke-2 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>

            <h3 class="text-lg sm:text-xl font-medium text-white group-hover:text-[#6BBF9A] transition-colors leading-snug drop-shadow-md">
              {p.title}
            </h3>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Featured Project Details Area below the bento grid for S.N. Public School -->
  <div class="mt-12 bg-white rounded-[24px] p-8 lg:p-12 border border-[#326262]/10 shadow-[0_4px_24px_-2px_rgba(50,98,98,0.06)]">
    <div class="flex flex-col lg:flex-row items-start justify-between gap-8">
      <div class="lg:w-1/2">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
            {featuredProject.label}
          </span>
          <span class="text-xs text-[#586261] font-medium">Bokaro Steel City</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-medium text-[#1C1B1B] mb-3 leading-snug">
          {featuredProject.title}
        </h3>

        <p class="text-base text-[#586261] leading-relaxed mb-6">
          {featuredProject.description}
        </p>

        <!-- Tech Badges -->
        <div class="flex flex-wrap gap-2 mb-6">
          {featuredProject.tech.map((t) => (
            <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
              {t}
            </span>
          ))}
        </div>

        <a
          href={featuredProject.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#326262] hover:bg-[#3E6161] text-white text-sm font-semibold transition-all shadow-sm"
        >
          <span>Open Live School Website</span>
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Features List -->
      <div class="lg:w-1/2 flex flex-col gap-3">
        <h4 class="text-xs uppercase tracking-widest text-[#326262] font-bold mb-2">
          KEY FEATURES &amp; MODULES
        </h4>
        {featuredProject.features?.map((feat) => (
          <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-[#FAF9F8] border border-[#326262]/5">
            <svg class="w-5 h-5 text-[#6BBF9A] shrink-0 mt-0.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm text-[#1C1B1B] font-medium leading-relaxed">
              {feat}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
