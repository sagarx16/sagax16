---
import { siteData } from '../data/site';
const { about } = siteData;

// Line icons for the 3 features
const icons = ['code', 'palette', 'chat'];
---

<section class="w-full bg-[#FAF9F8] py-14 sm:py-20 lg:py-28 text-[#1C1B1B]">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
    <!-- Eyebrow -->
    <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-6 sm:mb-10">
      {about.eyebrow}
    </span>

    <!-- Cards with Effect 6: 3D Tilt on hover & Green Block Wipe reveal -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 lg:gap-8">
      {about.cards.map((card, i) => (
        <div
          data-tilt
          data-block-wipe
          data-card-index={i}
          class="bg-white rounded-[20px] sm:rounded-[24px] p-6 sm:p-8 border border-[#326262]/10 shadow-[0_4px_20px_-2px_rgba(50,98,98,0.06)] hover:border-[#6BBF9A]/40 transition-colors flex flex-col justify-between"
        >
          <!-- Icon badge -->
          <div class="block-wipe-icon w-12 h-12 rounded-full bg-[#E5F0E1] flex items-center justify-center text-[#326262] mb-6">
            {i === 0 && (
              <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
              </svg>
            )}
            {i === 1 && (
              <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            )}
            {i === 2 && (
              <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            )}
          </div>

          <div>
            <h3 data-block-wipe-text class="text-xl font-medium text-[#1C1B1B] mb-3 leading-snug">
              {card.title}
            </h3>
            <p data-block-wipe-text class="text-base text-[#586261] leading-relaxed font-normal">
              {card.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
