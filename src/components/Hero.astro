---
import { siteData } from "../data/site";
const { hero } = siteData;
---

<section
  class="relative w-full overflow-hidden bg-[#101012] text-white pt-[136px] sm:pt-[160px] lg:pt-[208px] pb-14 sm:pb-20 lg:pb-32"
>
  <!-- Soft Teal Radial Glow Overlay -->
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-70"
  >
    <div
      class="w-[360px] h-[360px] sm:w-[600px] sm:h-[600px] lg:w-[960px] lg:h-[960px] rounded-full bg-[radial-gradient(circle,rgba(50,98,98,0.4)_0%,rgba(16,16,18,0)_70%)]"
    >
    </div>
  </div>

  <div
    class="relative max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col items-center text-center z-10"
  >
    <!-- Main Headline with Effect 1: Scroll-triggered text reveal -->
    <h1
      data-reveal="text"
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-white max-w-4xl leading-[1.15] mb-5 sm:mb-6"
    >
      {hero.heading}
    </h1>

    <!-- Subheading with text reveal -->
    <p
      data-reveal="text"
      class="text-sm sm:text-base lg:text-xl text-[#A9B5B4] max-w-2xl mb-8 sm:mb-10 leading-relaxed font-normal"
    >
      {hero.subheading}
    </p>

    <!-- CTAs: stacked full-width on mobile, side-by-side on tablet/desktop -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto max-w-xs sm:max-w-none mb-10 sm:mb-16">
      <a
        href={hero.primaryButton.href}
        class="w-full sm:w-auto text-center px-7 sm:px-8 py-3.5 rounded-full bg-[#6BBF9A] hover:bg-[#92CDAB] text-[#091414] font-semibold text-base transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-[0_4px_20px_-2px_rgba(107,191,154,0.3)] active:scale-[0.98]"
      >
        {hero.primaryButton.text}
      </a>
      <a
        href={hero.secondaryButton.href}
        class="w-full sm:w-auto text-center px-7 sm:px-8 py-3.5 rounded-full border border-white/20 hover:border-white/60 hover:bg-white/5 text-white font-semibold text-base transition-all duration-200 active:scale-[0.98]"
      >
        {hero.secondaryButton.text}
      </a>
    </div>

    <!-- Effect 2: Box Reveal for Project Mockups (Laptop and Phone - Modern, Sleek & Fully Visible!) -->
    <div
      class="w-full max-w-5xl flex items-end justify-center pt-2 sm:pt-4 relative"
    >
      <!-- Modern Showcase Display (PocketBank Desktop) -->
      <div
        data-reveal="box"
        data-box-color="teal"
        class="relative w-full max-w-[560px] sm:max-w-[650px] lg:max-w-[720px] rounded-2xl sm:rounded-3xl bg-[#0e1616]/90 p-2 sm:p-3 border border-white/20 shadow-[0_30px_90px_-20px_rgba(0,0,0,0.9)] backdrop-blur-md transition-all duration-500 hover:-translate-y-1"
      >
        <div class="box-content">
          <!-- Real Screenshot of PocketBank with clean rounded frame -->
          <div
            class="w-full bg-[#121316] rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] relative group border border-white/10 shadow-inner"
          >
            <img
              src="/projects/pocketbank.png"
              alt="PocketBank - Student Banking App by SAGA16"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="eager"
            />
          </div>

          <!-- Base of Laptop with subtle metallic highlight -->
          <div class="w-[92%] h-2 sm:h-2.5 bg-gradient-to-r from-[#182022] via-[#283638] to-[#182022] border-t border-white/15 rounded-b-lg sm:rounded-b-xl mt-2 mx-auto shadow-md">
          </div>
        </div>
      </div>

      <!-- Phone Mockup (PocketBank Mobile - Enlarged & Fully Visible) -->
      <div
        data-reveal="box"
        data-box-color="green"
        class="w-[140px] xs:w-[170px] sm:w-[220px] md:w-[250px] lg:w-[275px] shrink-0 rounded-[2.2rem] sm:rounded-[3rem] bg-[#121819] p-2 sm:p-3 pb-3 sm:pb-4 border-2 border-white/30 shadow-[0_25px_70px_rgba(0,0,0,0.95),0_0_30px_rgba(107,191,154,0.15)] relative z-20 -ml-12 xs:-ml-16 sm:-ml-10 lg:-ml-16 transition-all duration-500 hover:-translate-y-2 ring-1 ring-white/15"
      >
        <div class="box-content relative">
          <!-- Dynamic Island -->
          <div
            class="w-12 sm:w-20 h-3 sm:h-4.5 bg-black rounded-full mx-auto mb-2 sm:mb-2.5 flex items-center justify-between px-2 sm:px-2.5 shadow-inner ring-1 ring-white/15"
          >
            <span class="w-1.5 sm:w-2 h-1.5 sm:h-2 rounded-full bg-[#162736]"></span>
            <span class="w-1 sm:w-1.5 h-1 sm:h-1.5 rounded-full bg-[#233544]"></span>
          </div>

          <!-- Real Mobile Screenshot of PocketBank (Aspect matched to 612/1024 so entire mobile UI displays completely) -->
          <div
            class="w-full bg-[#f7fafd] rounded-[1.6rem] sm:rounded-[2.4rem] overflow-hidden aspect-[612/1024] relative group shadow-inner border border-white/10"
          >
            <img
              src="/projects/pocketbank-mobile.png"
              alt="PocketBank - Student Banking Mobile App by SAGA16"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="eager"
            />
            <!-- Gloss / Sheen overlay -->
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.04] to-white/[0.14] rounded-[1.6rem] sm:rounded-[2.4rem]"
            >
            </div>
          </div>

          <!-- Phone Home Indicator Bar at the bottom -->
          <div class="w-10 sm:w-16 h-1 bg-white/40 rounded-full mx-auto mt-2 sm:mt-2.5"></div>
        </div>
      </div>
    </div>
  </div>
</section>
