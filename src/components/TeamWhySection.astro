---
import { siteData } from '../data/site';
const { teamWhy } = siteData;
---

<section class="w-full bg-[#FAF9F8] py-14 sm:py-20 lg:py-28 text-[#1C1B1B] border-t border-[#326262]/5">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
    <!-- Effect 9: Sticky column layout on desktop (>=1024px) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Left Column: Sticky on desktop -->
      <div class="lg:col-span-5 sticky-column">
        <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-2 sm:mb-3">
          {teamWhy.eyebrow}
        </span>
        <h2
          data-reveal="text"
          class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] leading-[1.15] mb-4 sm:mb-6"
        >
          {teamWhy.heading}
        </h2>
        <p class="text-sm sm:text-base text-[#586261] font-normal leading-relaxed max-w-sm">
          Transparent development, zero middlemen, and dedicated craftsmanship.
        </p>
      </div>

      <!-- Right Column: 3 Cards with 3D tilt (Effect 6) -->
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-6">
        {teamWhy.cards.map((card, i) => (
          <div
            data-tilt
            class="bg-white rounded-[20px] sm:rounded-[24px] p-5 sm:p-8 border border-[#326262]/10 shadow-[0_4px_20px_-2px_rgba(50,98,98,0.06)] hover:border-[#6BBF9A]/40 transition-colors flex flex-col justify-between"
          >
            <div class="w-12 h-12 rounded-full bg-[#E5F0E1] flex items-center justify-center text-[#326262] mb-4 sm:mb-6">
              {i === 0 && (
                <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              )}
              {i === 1 && (
                <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              )}
              {i === 2 && (
                <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
                </svg>
              )}
            </div>

            <h3 class="text-xl font-medium text-[#1C1B1B] mb-2 leading-snug">
              {card.title}
            </h3>
            <p class="text-base text-[#586261] font-normal leading-relaxed">
              {card.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
