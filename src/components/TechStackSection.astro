---
import { siteData } from '../data/site';
const { techStack } = siteData;

// Icon mappings for tech stack
const getTechIcon = (name: string) => {
  switch (name) {
    case 'Next.js': return 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5';
    case 'React': return 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h2v-6h-2v6zm0-8h2V7h-2v2z';
    case 'TypeScript': return 'M4 4h16v16H4V4zm8 10v-4m-3 0h6m2 4v-2c0-.5-.5-1-1-1h-1c-.5 0-1 .5-1 1v1c0 .5.5 1 1 1h1c.5 0 1 .5 1 1v1c0 .5-.5 1-1 1h-1c-.5 0-1-.5-1-1';
    case 'Tailwind CSS': return 'M12 4.5C7 4.5 3.75 7 2.25 12c1.5 5 4.75 7.5 9.75 7.5s8.25-2.5 9.75-7.5c-1.5-5-4.75-7.5-9.75-7.5z';
    case 'Node.js': return 'M12 2L3 7v10l9 5 9-5V7l-9-5zm0 2.2l6.8 3.8-6.8 3.8L5.2 8 12 4.2z';
    case 'Express': return 'M4 12h16M14 6l6 6-6 6';
    case 'MongoDB': return 'M12 2C8 6 6 9 6 13c0 4 3 7 6 9 3-2 6-5 6-9 0-4-2-7-6-11z';
    case 'Redux Toolkit': return 'M12 2l8 4.5v9L12 20l-8-4.5v-9L12 2z';
    case 'Astro': return 'M12 2.5l2.5 5.5H20l-4.5 3.5 1.7 5.5-5.2-3.8-5.2 3.8 1.7-5.5L4 8h5.5L12 2.5z';
    case 'JavaScript': return 'M3 3h18v18H3V3zm11 13h2.5c.8 0 1.5-.7 1.5-1.5v-2c0-.8-.7-1.5-1.5-1.5H14m-5 5v-3c0-.6-.4-1-1-1H7';
    case 'HTML5': return 'M4 3l1.5 17L12 22l6.5-2L20 3H4zm13 5H7l.3 3h9.4l-.5 5.5L12 17.5 7.8 16.5l-.2-2';
    case 'CSS3': return 'M4 3l1.5 17L12 22l6.5-2L20 3H4zm12 5H8l.2 3h7.6l-.6 6L12 18l-3.2-.8-.2-2.2';
    case 'Figma': return 'M8 4a3 3 0 0 1 3 3v2H8a3 3 0 0 1 0-6zm5 0h3a3 3 0 0 1 0 6h-3V4zm-5 5h3v3H8a3 3 0 0 1 0-3zm5 0h3a3 3 0 0 1 0 6h-3V9zm-5 5h3v3a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1 3-3z';
    case 'Git & GitHub': return 'M12 2C6.47 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z';
    case 'Vercel': return 'M12 2L2 19.5h20L12 2z';
    default: return 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5';
  }
};
---

<section class="w-full bg-[#FAF9F8] py-20 lg:py-28 overflow-hidden text-[#1C1B1B]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <!-- Left Column -->
    <div class="lg:col-span-5 flex flex-col items-start">
      <span class="text-xs uppercase tracking-widest text-[#326262] font-bold mb-3">
        {techStack.eyebrow}
      </span>
      <h2
        data-reveal="text"
        class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] mb-4 leading-[1.1]"
      >
        {techStack.heading}
      </h2>
      <p
        data-reveal="text"
        class="text-base sm:text-lg text-[#586261] mb-8 max-w-md font-normal leading-relaxed"
      >
        {techStack.description}
      </p>
      <a
        href={techStack.buttonHref}
        class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-[#326262] hover:bg-[#3E6161] text-white font-semibold text-sm transition-all hover:-translate-y-0.5 active:translate-y-0 shadow-sm"
      >
        <span>{techStack.buttonText}</span>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Right Column: Effect 4: Two-row opposite-direction box carousel -->
    <div class="lg:col-span-7 flex flex-col gap-4 overflow-hidden marquee-container marquee-fade-mask py-4">
      <!-- Row 1: Moving LEFT -->
      <div class="marquee-track-left items-center gap-3 select-none">
        <!-- Set 1 -->
        {techStack.row1.map((item) => (
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-white border border-[#326262]/15 shadow-sm text-[#1C1B1B] text-sm font-semibold shrink-0">
            <svg class="w-4 h-4 fill-none stroke-[#326262] stroke-2 shrink-0" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={getTechIcon(item)} />
            </svg>
            <span>{item}</span>
          </div>
        ))}

        <!-- Duplicated Set (aria-hidden for screen readers) -->
        {techStack.row1.map((item) => (
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-white border border-[#326262]/15 shadow-sm text-[#1C1B1B] text-sm font-semibold shrink-0" aria-hidden="true">
            <svg class="w-4 h-4 fill-none stroke-[#326262] stroke-2 shrink-0" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={getTechIcon(item)} />
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <!-- Row 2: Moving RIGHT (Offset by half a box) -->
      <div class="marquee-track-right items-center gap-3 select-none -ml-16">
        <!-- Set 1 -->
        {techStack.row2.map((item) => (
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-white border border-[#326262]/15 shadow-sm text-[#1C1B1B] text-sm font-semibold shrink-0">
            <svg class="w-4 h-4 fill-none stroke-[#326262] stroke-2 shrink-0" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={getTechIcon(item)} />
            </svg>
            <span>{item}</span>
          </div>
        ))}

        <!-- Duplicated Set (aria-hidden) -->
        {techStack.row2.map((item) => (
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-white border border-[#326262]/15 shadow-sm text-[#1C1B1B] text-sm font-semibold shrink-0" aria-hidden="true">
            <svg class="w-4 h-4 fill-none stroke-[#326262] stroke-2 shrink-0" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={getTechIcon(item)} />
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
