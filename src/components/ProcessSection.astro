---
import { siteData } from '../data/site';
const { process } = siteData;

interface Props {
  eyebrow?: string;
  heading?: string;
}

const {
  eyebrow = 'OUR PROCESS',
  heading = process.heading,
} = Astro.props;
---

<section class="w-full bg-[#E5F0E1] py-14 sm:py-20 lg:py-28 text-[#1C1B1B]">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
    <!-- Grid container: On lg (>=1024px), left column is sticky while right column cards scroll -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Left Column: Sticky on desktop (Effect 9) -->
      <div class="lg:col-span-5 sticky-column">
        <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-2 sm:mb-3">
          {eyebrow}
        </span>
        <h2
          data-reveal="text"
          class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] leading-[1.15] mb-4 sm:mb-6"
        >
          {heading}
        </h2>
        <p class="text-sm sm:text-base text-[#586261] font-normal leading-relaxed max-w-sm">
          A clear, disciplined progression from first consultation to final deployment.
        </p>
      </div>

      <!-- Right Column: 4 Step Cards scrolling on right -->
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-6">
        {process.steps.map((step) => (
          <div
            data-tilt
            class="bg-white rounded-[20px] sm:rounded-[24px] p-5 sm:p-8 border border-[#326262]/10 shadow-[0_4px_20px_-2px_rgba(50,98,98,0.06)] hover:border-[#6BBF9A]/40 transition-colors flex flex-row items-start gap-4 sm:gap-6"
          >
            <!-- Step Number Badge -->
            <span class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#E5F0E1] text-[#326262] font-bold text-base sm:text-xl flex items-center justify-center shrink-0 shadow-inner">
              {step.number}
            </span>

            <div>
              <h3 class="text-lg sm:text-xl font-medium text-[#1C1B1B] mb-1.5 sm:mb-2 leading-snug">
                {step.title}
              </h3>
              <p class="text-sm sm:text-base text-[#586261] font-normal leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
