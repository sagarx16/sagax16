---
import { siteData } from '../data/site';
const { categories } = siteData;
---

<section class="w-full bg-[#091414] text-white py-14 sm:py-20 lg:py-28 border-t border-white/10">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
    <!-- Heading Block -->
    <div class="mb-14 sm:mb-16 md:mb-20">
      <h2
        data-reveal="text"
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[56px] font-normal tracking-[-0.02em] text-white leading-[1.1]"
      >
        {categories.heading}
      </h2>
      <p
        class="mt-4 text-[16px] sm:text-[18px] text-white/75 leading-[1.5] max-w-[900px] font-normal"
      >
        {categories.description}
      </p>
    </div>

    <!-- Rows with Hairline Dividers (leveingroup.com pattern) -->
    <div class="flex flex-col border-t border-white/[0.12]">
      {categories.rows.map((row, index) => (
        <div
          class="category-row group relative py-[28px] md:py-[40px] border-b border-white/[0.12] hover:border-[#6BBF9A] transition-colors duration-250 ease-out cursor-default"
          style={`transition-delay: ${index * 80}ms;`}
        >
          <div class="grid grid-cols-1 md:grid-cols-2 md:gap-0 items-center">
            <!-- Left Column: Title in large type (starts at 0%) -->
            <div class="pr-0 md:pr-8">
              <h3 class="category-title text-[30px] md:text-[clamp(32px,3.6vw,52px)] font-normal leading-[1.1] tracking-[-0.01em] text-white select-none">
                {row.title}
              </h3>
            </div>

            <!-- Right Column: Description starts exactly at 50% mark, vertically centered -->
            <div class="relative mt-3 md:mt-0 flex items-center justify-between pr-0 md:pr-10">
              <p class="text-[16px] md:text-[18px] leading-[1.6] text-white/[0.85] max-w-[620px] font-normal">
                {row.description || (row as any).text}
              </p>

              <!-- 20px Arrow Icon (→) at far right edge of the row, vertically centered, fades in on hover -->
              <span
                class="hidden md:inline-flex absolute right-0 top-1/2 -translate-y-1/2 w-5 h-5 items-center justify-center text-[#6BBF9A] opacity-0 group-hover:opacity-100 transition-opacity duration-250 ease-out pointer-events-none"
                aria-hidden="true"
              >
                <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Effect 3: Infinite carousel, single row framed with thin corner brackets (Unchanged) -->
    <div class="mt-16 pt-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="shrink-0">
        <span class="block text-xs uppercase tracking-[0.2em] text-[#A9B5B4] font-semibold leading-relaxed">
          {categories.marqueeLabel}
        </span>
      </div>

      <!-- Marquee container with corner brackets -->
      <div class="relative w-full overflow-hidden p-4 rounded-xl border border-white/10 bg-white/[0.02] marquee-container marquee-fade-mask">
        <!-- Thin corner brackets -->
        <span class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>
        <span class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#6BBF9A] pointer-events-none" aria-hidden="true"></span>

        <!-- Continuous left scroll with duplicate set for seamless loop -->
        <div class="marquee-track-left items-center gap-8 py-1 select-none">
          <!-- Loop Set 1 -->
          {categories.marqueeProjects.map((project) => (
            <div class="inline-flex items-center gap-8 shrink-0">
              <span class="text-sm sm:text-base font-semibold text-white tracking-widest whitespace-nowrap">
                {project}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#6BBF9A] shrink-0" aria-hidden="true"></span>
            </div>
          ))}

          <!-- Loop Set 2 (duplicated, aria-hidden for accessibility) -->
          {categories.marqueeProjects.map((project) => (
            <div class="inline-flex items-center gap-8 shrink-0" aria-hidden="true">
              <span class="text-sm sm:text-base font-semibold text-white tracking-widest whitespace-nowrap">
                {project}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#6BBF9A] shrink-0"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Subtle scroll reveal animation: translateY(16px) -> 0, opacity 0 -> 1, 500ms ease-out */
  .category-row {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 500ms ease-out, transform 500ms ease-out, border-color 250ms ease;
    will-change: opacity, transform;
  }

  .category-row.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Fallback if JS is disabled */
  :not(.js) .category-row {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-row {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initCategoriesReveal() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.category-row').forEach((row) => {
        row.classList.add('is-revealed');
      });
      return;
    }

    const rows = document.querySelectorAll<HTMLElement>('.category-row');
    if (!rows.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    rows.forEach((row) => observer.observe(row));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoriesReveal);
  } else {
    initCategoriesReveal();
  }
</script>
