---
import { siteData } from '../data/site';
const { projects } = siteData;
---

<section class="w-full bg-[#FAF9F8] py-14 sm:py-20 lg:py-28 text-[#1C1B1B]">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div>
        <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-2 sm:mb-3">
          PORTFOLIO
        </span>
        <h2
          data-reveal="text"
          class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] leading-[1.15]"
        >
          Our Work
        </h2>
      </div>

      <a
        href="/our-work"
        class="hidden sm:inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-[#326262]/20 hover:bg-[#326262] hover:text-white text-[#326262] font-semibold text-sm transition-all"
      >
        <span>See All Projects</span>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 6 Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8 mb-8 sm:mb-12">
      {projects.map((project, idx) => (
        <div
          data-tilt
          class="bg-white rounded-[20px] sm:rounded-[24px] p-5 sm:p-6 border border-[#326262]/10 shadow-[0_4px_20px_-2px_rgba(50,98,98,0.06)] hover:border-[#6BBF9A]/40 transition-colors flex flex-col justify-between"
        >
          <div>
            <!-- Live Project Screenshot in Sleek Browser Frame -->
            <div
              class="w-full h-48 sm:h-56 bg-[#0E1216] rounded-2xl mb-5 sm:mb-6 overflow-hidden relative group/img border border-[#326262]/15 shadow-md flex flex-col"
            >
              <div class="w-full h-full relative flex flex-col bg-[#14181D]">
                <!-- Browser Bar Overlay -->
                <div class="w-full px-3.5 py-2 bg-[#101418] border-b border-white/10 flex items-center justify-between z-10 shrink-0">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#EF4444]/90"></span>
                    <span class="w-2 h-2 rounded-full bg-[#F59E0B]/90"></span>
                    <span class="w-2 h-2 rounded-full bg-[#10B981]/90"></span>
                  </div>
                  <div class="px-2.5 py-0.5 rounded-full bg-white/5 text-[10px] text-white/60 font-mono tracking-tight flex items-center gap-1 border border-white/5">
                    <span>{project.tech[0]}</span>
                  </div>
                </div>

                <!-- Real Screenshot -->
                <div class="w-full flex-1 relative overflow-hidden bg-black">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top group-hover/img:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>

            <!-- Label Pill -->
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
                {project.label}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-medium text-[#1C1B1B] mb-6 leading-snug">
              {project.title}
            </h3>
          </div>

          <!-- View Live Site CTA -->
          <div class="pt-4 border-t border-[#326262]/5">
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/btn inline-flex items-center justify-center gap-2 w-full py-2.5 rounded-full border border-[#326262]/20 hover:bg-[#326262] hover:text-white text-[#326262] text-sm font-semibold transition-all shadow-sm"
            >
              <span>View live site</span>
              <svg class="w-4 h-4 fill-none stroke-current stroke-2 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" viewBox="0 0 24 24">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile See All Projects -->
    <div class="flex sm:hidden justify-center">
      <a
        href="/our-work"
        class="px-8 py-3 rounded-full bg-[#326262] text-white font-semibold text-sm shadow-md"
      >
        See All Projects
      </a>
    </div>
  </div>
</section>
