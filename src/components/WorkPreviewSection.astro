---
import { siteData } from '../data/site';
const { projects } = siteData;
---

<section class="w-full bg-[#FAF9F8] py-20 lg:py-28 text-[#1C1B1B]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div>
        <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-3">
          PORTFOLIO
        </span>
        <h2
          data-reveal="text"
          class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] leading-[1.1]"
        >
          Our Work
        </h2>
      </div>

      <a
        href="/our-work"
        class="hidden sm:inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-[#326262]/20 hover:bg-[#326262] hover:text-white text-[#326262] font-semibold text-sm transition-all"
      >
        <span>See All Projects</span>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 6 Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {projects.map((project, idx) => (
        <div
          data-tilt
          class="bg-white rounded-[24px] p-6 border border-[#326262]/10 shadow-[0_4px_20px_-2px_rgba(50,98,98,0.06)] hover:border-[#6BBF9A]/40 transition-colors flex flex-col justify-between"
        >
          <div>
            <!-- Abstract Wireframe Mockup with Box Reveal (Effect 2) -->
            <!-- TODO: Replace abstract wireframes with real screenshots of live client projects -->
            <div
              data-reveal="box"
              data-box-color={idx % 2 === 0 ? 'teal' : 'green'}
              class="w-full h-44 bg-[#F0EDED] rounded-2xl p-4 flex flex-col justify-between mb-6 overflow-hidden"
            >
              <div class="box-content w-full h-full flex flex-col justify-between">
                <!-- Browser Bar -->
                <div class="flex items-center justify-between border-b border-[#326262]/5 pb-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#1C1B1B]/20"></span>
                    <span class="w-2 h-2 rounded-full bg-[#1C1B1B]/20"></span>
                    <span class="w-2 h-2 rounded-full bg-[#1C1B1B]/20"></span>
                  </div>
                  <div class="w-20 h-2 bg-[#1C1B1B]/10 rounded-full"></div>
                </div>

                <!-- Abstract UI Blocks without readable text -->
                <div class="flex flex-col gap-2 my-auto">
                  <div class="w-3/4 h-3.5 bg-[#326262]/20 rounded"></div>
                  <div class="w-1/2 h-2.5 bg-[#326262]/10 rounded"></div>
                </div>

                <div class="grid grid-cols-3 gap-2 pt-2">
                  <div class="h-6 bg-[#326262]/5 rounded"></div>
                  <div class="h-6 bg-[#326262]/5 rounded"></div>
                  <div class="h-6 bg-[#6BBF9A]/20 rounded"></div>
                </div>
              </div>
            </div>

            <!-- Label Pill -->
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 rounded-full bg-[#E5F0E1] text-[#326262] text-xs font-semibold">
                {project.label}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-medium text-[#1C1B1B] mb-6 leading-snug">
              {project.title}
            </h3>
          </div>

          <!-- View Live Site CTA -->
          <div class="pt-4 border-t border-[#326262]/5">
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-full py-2.5 rounded-full border border-[#326262]/20 hover:bg-[#326262] hover:text-white text-[#326262] text-sm font-semibold transition-colors"
            >
              View live site
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile See All Projects -->
    <div class="flex sm:hidden justify-center">
      <a
        href="/our-work"
        class="px-8 py-3 rounded-full bg-[#326262] text-white font-semibold text-sm shadow-md"
      >
        See All Projects
      </a>
    </div>
  </div>
</section>
