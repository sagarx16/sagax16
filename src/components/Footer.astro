---
import { siteData } from '../data/site';

const { company } = siteData;
---

<footer class="relative w-full text-[#101012] pt-14 sm:pt-[80px] pb-0">
  <div class="relative max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 z-10">
    <!-- Main Footer Grid: 1.4fr 1fr 1fr 1fr 1fr on desktop, 2 col on tablet, 1 column on mobile -->
    <div class="footer-grid pb-10 sm:pb-14 items-start">
      <!-- Left block: Logo, paragraph, and social container -->
      <div class="flex flex-col items-start gap-5">
        <!-- Logo: SAGA16 (bold italic style) -->
        <a
          href="/"
          class="footer-logo text-3xl text-[#101012] select-none hover:opacity-80 transition-opacity"
          aria-label="SAGA16 Home"
        >
          SAGA16
        </a>
        <!-- Paragraph: about 15% larger, line-height 1.7 -->
        <p class="footer-desc text-[#2D5854] font-medium max-w-[340px]">
          Professional websites for institutions, businesses and celebrations. Designed and built in India.
        </p>

        <!-- Social Icons Pill: border 1.5px solid dark #101012, icons ~40% larger (22px), near-black #101012, more padding inside pill -->
        <div class="social-pill inline-flex items-center gap-5 rounded-full bg-white/40 backdrop-blur-sm">
          <!-- 1. GitHub -->
          <a
            href="https://github.com/sagarx16"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#101012] hover:text-[#2D5854] transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>

          <!-- 2. Instagram -->
          <a
            href="https://instagram.com/sagarx16"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#101012] hover:text-[#2D5854] transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>

          <!-- 3. WhatsApp -->
          <a
            href="https://wa.me/917050836284"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#101012] hover:text-[#2D5854] transition-colors"
            aria-label="WhatsApp"
          >
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.55c.13.16 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
            </svg>
          </a>

          <!-- 4. LinkedIn -->
          <a
            href="https://www.linkedin.com/in/sagar-pathak-9360a9372"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#101012] hover:text-[#2D5854] transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column "Company" -->
      <div class="col-links flex flex-col">
        <span class="col-heading">
          Company
        </span>
        <a href="/" class="footer-link">Home</a>
        <a href="/our-work" class="footer-link">Our Work</a>
        <a href="/team" class="footer-link">Team</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>

      <!-- Column "Services" -->
      <div class="col-links flex flex-col">
        <span class="col-heading">
          Services
        </span>
        <a href="/our-work" class="footer-link">Wedding Invitation Websites</a>
        <a href="/our-work" class="footer-link">Birthday and Event Invitations</a>
        <a href="/our-work" class="footer-link">Business Websites</a>
        <a href="/our-work" class="footer-link">Personal Portfolio Websites</a>
        <a href="/our-work" class="footer-link">Small-Business Websites</a>
        <a href="/our-work" class="footer-link">Custom Branding and Graphic Design</a>
      </div>

      <!-- Column "Projects" -->
      <div class="col-links flex flex-col">
        <span class="col-heading">
          Projects
        </span>
        <a
          href="https://sharda-academy-smoky.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          S.N. Public School
        </a>
        <a
          href="https://invifestx16.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Royal Wedding Invitation
        </a>
        <a
          href="https://civic-voicex16.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          CivicVoice
        </a>
        <a
          href="https://hackathon-pocketmoney-main.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          PocketBank
        </a>
        <a
          href="https://sachet-five.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Sachet
        </a>
        <a
          href="https://ghiblix16.vercel.app/movies"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Ghibli Tribute
        </a>
        <a
          href="https://sage-wellness.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Sage Wellness
        </a>
      </div>

      <!-- Right block (right-aligned): Request a call button, phone, email, India -->
      <div class="flex flex-col items-start lg:items-end gap-[18px] text-left lg:text-right">
        <!-- "Request a call" button: font-weight 700, ~15% larger text, slightly larger padding -->
        <a
          href="tel:+917050836284"
          class="request-call-btn inline-flex items-center justify-center transition-all shadow-sm hover:-translate-y-0.5 active:translate-y-0"
        >
          Request a call
        </a>

        <!-- Phone: same size for all three, ~15% larger, right-aligned -->
        <a
          href="tel:+917050836284"
          class="contact-line contact-underline font-bold"
        >
          +91 7050836284
        </a>

        <!-- Email: same size, font-medium, underlined -->
        <a
          href="mailto:sagarixa@gmail.com"
          class="contact-line contact-underline font-medium"
        >
          sagarixa@gmail.com
        </a>

        <!-- Plain text India: exactly the same size and colour as email, NOT a link, no underline -->
        <span class="contact-line font-medium">
          India
        </span>
      </div>
    </div>

    <!-- Bottom divider line: extends slightly wider than content area (~40px each side), soft teal-grey -->
    <div class="footer-divider-wrapper -mx-6 lg:-mx-10 border-t border-[#3A6B66]/30 pt-8 pb-4 text-center">
      <!-- Copyright text: about 15% larger, near-black -->
      <p class="copyright-text font-semibold text-[#101012]">
        © 2026 SAGA16. All rights reserved.
      </p>
    </div>
  </div>

  <!-- Giant faded SAGA16 wordmark (below copyright bar) -->
  <div class="footer-wordmark" aria-hidden="true">SAGA16</div>
</footer>

<style>
  footer {
    overflow: hidden;
  }

  .footer-logo {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 2.5rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
    }
  }

  /* Description: about 15% larger, line-height 1.7 */
  .footer-desc {
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Column headings: about 30% larger (18px), font-weight 600, near-black #101012 */
  .col-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: #101012;
    margin-bottom: 0.625rem;
    line-height: 1.3;
  }

  /* Column links: about 15% larger (16px), colour deep teal #326262, gap increased by ~50% (18px) */
  .col-links {
    gap: 18px;
  }

  .footer-link {
    font-size: 1rem;
    font-weight: 500;
    color: #326262;
    transition: color 0.15s ease;
    line-height: 1.4;
  }

  .footer-link:hover {
    color: #101012;
  }

  /* Social icons pill: border 1.5px solid dark #101012, more padding inside the pill */
  .social-pill {
    border: 1.5px solid #101012;
    padding: 10px 20px;
  }

  @media (min-width: 640px) {
    .social-pill {
      padding: 12px 24px;
    }
  }

  /* Request a call button: font-weight 700, ~15% larger text, slightly larger padding */
  .request-call-btn {
    font-size: 1rem;
    font-weight: 700;
    padding: 12px 30px;
    border-radius: 999px;
    background-color: #2D5854;
    color: #ffffff;
    width: 100%;
    text-align: center;
  }

  @media (min-width: 640px) {
    .request-call-btn {
      width: auto;
    }
  }

  .request-call-btn:hover {
    background-color: #1D3E3A;
  }

  /* Contact lines: phone, email, India: same size (1rem / 16px), right-aligned */
  .contact-line {
    font-size: 1rem;
    color: #101012;
    line-height: 1.4;
  }

  .contact-underline {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(16, 16, 18, 0.6);
    transition: color 0.15s ease;
  }

  .contact-underline:hover {
    color: #2D5854;
  }

  /* Copyright text: about 15% larger, near-black */
  .copyright-text {
    font-size: 1rem;
    color: #101012;
  }

  /* Giant wordmark at the very bottom */
  .footer-wordmark {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(5rem, 24vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
    width: 100%;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    pointer-events: none;
    margin-bottom: -0.18em; /* crops the bottom of the letters */
  }
</style>
