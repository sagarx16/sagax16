---
import { siteData } from '../data/site';
const { faq } = siteData;
---

<section class="w-full bg-[#E5F0E1] py-20 lg:py-28 text-[#1C1B1B]">
  <div class="max-w-[800px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-12">
      <span class="inline-block text-xs uppercase tracking-widest text-[#326262] font-bold mb-3">
        QUESTIONS
      </span>
      <h2
        data-reveal="text"
        class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#1C1B1B] leading-[1.1]"
      >
        Frequently asked questions
      </h2>
    </div>

    <!-- Accordion Items List -->
    <div class="flex flex-col gap-4">
      {faq.map((item, index) => (
        <div
          data-faq-item
          class="bg-white rounded-[20px] p-6 border border-[#326262]/10 shadow-[0_2px_12px_-2px_rgba(50,98,98,0.04)] transition-all"
        >
          <button
            type="button"
            data-faq-trigger
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
            class="w-full flex items-center justify-between gap-4 text-left cursor-pointer group"
          >
            <h3 class="text-lg sm:text-xl font-medium text-[#1C1B1B] group-hover:text-[#326262] transition-colors leading-snug">
              {item.question}
            </h3>

            <!-- Rotating chevron toggle badge -->
            <div
              data-faq-icon
              class="w-9 h-9 rounded-full bg-[#FAF9F8] border border-[#326262]/15 flex items-center justify-center text-[#326262] shrink-0 transition-transform duration-300"
              aria-hidden="true"
            >
              <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>

          <!-- Smooth height animated content -->
          <div
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-question-${index}`}
            data-faq-content
            class="overflow-hidden transition-[max-height] duration-300 ease-in-out"
            style="max-height: 0px;"
          >
            <p class="text-base text-[#586261] font-normal leading-relaxed pt-4 border-t border-[#326262]/10 mt-4">
              {item.answer}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
