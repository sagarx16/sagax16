---
import { siteData } from '../data/site';

interface Props {
  currentPage?: 'home' | 'our-work' | 'team' | 'contact';
}

const { currentPage = 'home' } = Astro.props;
const { company, nav } = siteData;
---

<!-- Sticky Navbar -->
<header
  data-site-header
  class="site-nav fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300"
>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Logo: SAGA16 in bold italic style -->
    <a
      href="/"
      class="nav-logo text-2xl lg:text-3xl text-[#326262] hover:text-[#1c4e4e] transition-colors select-none"
      aria-label="SAGA16 Home"
    >
      SAGA16
    </a>

    <!-- Desktop Navigation: Pill container -->
    <nav class="nav-pill-container hidden md:flex items-center gap-1.5 p-1 rounded-full" aria-label="Main Navigation">
      {nav.map((item) => {
        const isActive =
          (item.href === '/' && currentPage === 'home') ||
          (item.href === '/our-work' && currentPage === 'our-work') ||
          (item.href === '/team' && currentPage === 'team') ||
          (item.href === '/contact' && currentPage === 'contact');

        return (
          <a
            href={item.href}
            class:list={[
              'px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200',
              isActive
                ? 'bg-[#2f5d62] text-white shadow-sm'
                : 'text-[#4a5f5c] hover:text-[#101012] hover:bg-white/60',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.title}
          </a>
        );
      })}
    </nav>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href={company.tel}
        class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#326262] text-white hover:bg-[#3E6161] text-sm font-semibold transition-all shadow-[0_4px_14px_-2px_rgba(50,98,98,0.25)] hover:-translate-y-0.5 active:translate-y-0"
      >
        Call Now
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
        class="md:hidden relative w-11 h-11 flex items-center justify-center rounded-full bg-[#E5F0E1] text-[#326262] hover:bg-[#326262] hover:text-white transition-all active:scale-95 shadow-sm cursor-pointer"
      >
        <!-- Hamburger Icon -->
        <svg data-icon-menu class="w-6 h-6 fill-none stroke-current stroke-2 transition-all duration-200" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close (X) Icon -->
        <svg data-icon-close class="w-6 h-6 fill-none stroke-current stroke-2 transition-all duration-200 hidden" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div
    data-mobile-backdrop
    class="fixed inset-0 top-20 bg-black/40 backdrop-blur-sm z-40 hidden md:hidden transition-opacity duration-300 opacity-0"
    aria-hidden="true"
  ></div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden md:hidden fixed inset-x-0 top-20 z-50 bg-[#FAF9F8]/95 backdrop-blur-xl border-b border-[#326262]/15 shadow-2xl px-5 py-5 transition-all duration-300 -translate-y-4 opacity-0 max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    <nav class="nav-pill-mobile flex flex-col gap-1.5 p-3 rounded-2xl bg-white/80 border border-[#326262]/10 shadow-sm">
      {nav.map((item) => {
        const isActive =
          (item.href === '/' && currentPage === 'home') ||
          (item.href === '/our-work' && currentPage === 'our-work') ||
          (item.href === '/team' && currentPage === 'team') ||
          (item.href === '/contact' && currentPage === 'contact');

        return (
          <a
            href={item.href}
            class:list={[
              'flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold transition-all duration-200',
              isActive
                ? 'bg-[#2f5d62] text-white shadow-sm'
                : 'text-[#4a5f5c] hover:text-[#101012] hover:bg-[#E5F0E1]/60 active:scale-[0.99]',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span>{item.title}</span>
            {isActive ? (
              <span class="w-2 h-2 rounded-full bg-[#6BBF9A]"></span>
            ) : (
              <svg class="w-4 h-4 text-[#4a5f5c]/60 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            )}
          </a>
        );
      })}

      <!-- Quick Action CTAs for Mobile -->
      <div class="pt-3 mt-1 border-t border-[#326262]/10 grid grid-cols-2 gap-2.5">
        <a
          href={company.tel}
          class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#2f5d62] hover:bg-[#23484c] text-white text-sm font-semibold shadow-sm transition-all active:scale-[0.98]"
        >
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Now</span>
        </a>
        <a
          href="https://wa.me/917050836284"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#6BBF9A] hover:bg-[#58a885] text-[#091414] text-sm font-semibold shadow-sm transition-all active:scale-[0.98]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.55c.13.16 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-logo {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .nav-pill-container {
    background-color: #e8f0e6;
    border: 1px solid rgba(47, 93, 98, 0.08);
    box-shadow: none;
  }

  .nav-pill-mobile {
    background-color: #e8f0e6;
    border: 1px solid rgba(47, 93, 98, 0.08);
  }
</style>
